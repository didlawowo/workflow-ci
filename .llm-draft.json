{
  "_comment": "Contrôles des jets du harnais LLM (didlawowo/llm-harness), calqués sur quality-report-selftest : pytest + pyyaml sans projet uv, PYTHONPATH à la racine.",
  "draft_checks": [
    {
      "paths": [
        "*"
      ],
      "commands": [
        [
          "env",
          "PYTHONPATH=.",
          "uv",
          "run",
          "--no-project",
          "--with",
          "pytest",
          "--with",
          "pyyaml",
          "python",
          "-m",
          "pytest",
          "-q",
          "-p",
          "no:cacheprovider",
          "tests"
        ]
      ]
    }
  ],
  "acceptance_command": [
    "env",
    "PYTHONPATH=.",
    "uv",
    "run",
    "--no-project",
    "--with",
    "pytest",
    "--with",
    "pyyaml",
    "python",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "{fichier}"
  ]
}
